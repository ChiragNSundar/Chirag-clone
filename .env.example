# ============================================
# Chirag Clone — Local-First Configuration
# ============================================
# No cloud API keys needed! Everything runs locally.
# Copy this to .env and customize as needed.

# Flask Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# ============= LM Studio (PRIMARY LLM) =============
# LM Studio is the sole LLM provider. It exposes an OpenAI-compatible
# API at localhost:1234 by default. Load any model you like.
# If LM Studio is not running, the system falls back to RAG + context files.

LMSTUDIO_BASE_URL=http://localhost:1234
# Model: 'auto' = detect whatever model is loaded in LM Studio
# Or set explicitly: LMSTUDIO_MODEL=qwen2.5-coder-32b-instruct
LMSTUDIO_MODEL=auto

# ============= Identity =============
# THIS IS WHO THE BOT BECOMES
BOT_NAME=Chirag
USER_NAME=User

# ============= Context Files (Offline RAG) =============
# Directory for .txt/.md/.json context files that are auto-loaded
# and used for RAG-powered responses. Put your knowledge here.
CONTEXT_FILES_DIR=./data/context

# ============= Social Autopilot (optional) =============
# Discord: Create bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Telegram: Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Training Center Security
TRAINING_PASSCODE=1234

# Twitter/X Autopilot (optional)
# Create app at https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# LinkedIn Autopilot (optional - uses unofficial API)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Gmail Autopilot (optional)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Voice (optional — local voice via faster-whisper/piper-tts)
# ElevenLabs removed — use local voice services only
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Calendar (optional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# WhatsApp Business API (optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# OAuth2 / Google Login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Security
JWT_SECRET=your-secure-jwt-secret
ALLOWED_ADMIN_EMAILS=chiragns12@gmail.com

# ============= Local Training Settings =============
LOCAL_TRAINING_ENABLED=true
LOCAL_ADAPTERS_DIR=./adapters
LOCAL_MODELS_DIR=./models
DEFAULT_BASE_MODEL=unsloth/phi-2-bnb-4bit
GPU_MEMORY_FRACTION=0.9

# Default LoRA hyperparameters
DEFAULT_LORA_R=16
DEFAULT_LORA_ALPHA=32
DEFAULT_MAX_SEQ_LENGTH=2048

# WandB for experiment tracking (optional)
WANDB_API_KEY=
WANDB_PROJECT=chirag-clone-training

# ============= Agentic Capabilities =============

# PII Scrubbing — optional (all data stays local now)
PII_SCRUB_ENABLED=false
PII_SCRUB_LEVEL=moderate

# Shell Execution
SHELL_EXEC_ENABLED=true
SHELL_EXEC_TIMEOUT=30
SHELL_EXEC_MAX_OUTPUT=50000
SHELL_EXEC_REQUIRE_APPROVAL=true

# Sandbox — restricted Python REPL
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_OUTPUT_CHARS=10000

# Autopilot Execution
AUTOPILOT_EXEC_MODE=draft_only
AUTOPILOT_MAX_PER_HOUR=20
AUTOPILOT_COOLDOWN_SECONDS=30

# Background Processing
BACKGROUND_PROCESSOR_ENABLED=true
